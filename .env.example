# ===================================================================
# AegisAI — Environment Configuration (example)
# Copy to .env and fill in real values. Never commit real secrets.
#
# Architecture note: this is a modular monolith. The six logical
# services (Identity, Gateway, Privacy, Policy, Model/Provider,
# Security/Audit) share one API process (`apps/api`). They do not
# currently expose separate HTTP ports, so IDENTITY_SERVICE_URL /
# GATEWAY_SERVICE_URL / etc. are intentionally not used.
# Browser traffic uses VITE_API_BASE_URL; Docker Compose uses
# internal service DNS (postgres, mongo, redis, api, soap-mock).
# ===================================================================

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- PostgreSQL (host-side npm run / migrations) ---
# Docker publishes Postgres on POSTGRES_HOST_PORT (default 5433).
POSTGRES_USER=aegisai
POSTGRES_PASSWORD=your_local_postgres_password
POSTGRES_DB=aegisai
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql://aegisai:your_local_postgres_password@localhost:5433/aegisai

# --- MongoDB ---
MONGODB_URL=mongodb://localhost:27017/aegisai

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- JWT (use a stable local secret; do not generate a new one on every boot) ---
# Generate a secure local secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_random_local_secret
JWT_EXPIRES_IN=15m

# --- CORS (comma-separated list of allowed origins) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:80

# --- Public API URL (docs, health checks, host-side tools) ---
API_PUBLIC_URL=http://localhost:4000

# --- Web Application Base URL (for email links, reset password, etc.) ---
APP_BASE_URL=http://localhost:5173

# --- AI providers (optional; gateway still works with the mock provider) ---
# Leave empty locally if you are not calling that provider.
# Backend-only: these keys are never sent to the browser or logged.
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# --- Email & SMTP Service (optional) ---
# If unset, EmailService falls back to a development test account (Ethereal)
# and logs email preview URLs to the console.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="AegisAI Security <noreply@aegisai.local>"

# --- Privacy Scanner (optional). Comma-separated extra keywords. ---
# SENSITIVE_KEYWORDS=confidential,internal only,do not distribute,trade secret

# --- Rate limiting (optional; gateway defaults apply if unset) ---
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=100

# --- Legacy SOAP mock ---
# Host-side default. Docker Compose overrides this to http://soap-mock:5005
# for the api container.
SOAP_MOCK_URL=http://localhost:5005
SOAP_MOCK_PORT=5005

# --- Local demo admin seed (scripts/seed_user.js) ---
SEED_ADMIN_EMAIL=admin@aegisai.local
SEED_ADMIN_PASSWORD=your_local_admin_password
SEED_ORG_NAME=AegisAI Demo Organization
SEED_ORG_SLUG=aegisai-demo-organization
SEED_ROLE=ORGANIZATION_ADMIN

# --- Frontend (Vite). Only VITE_* is exposed to the browser bundle. ---
# Keep this a relative path so Docker nginx can proxy /v1 to the api container.
VITE_API_BASE_URL=/v1
# Vite-dev proxy target only (not bundled into production).
API_PROXY_TARGET=http://localhost:4000

